# ROK VPN Portal — environment variable template.
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Flask session security ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ROK_SECRET_KEY=change-me-generate-a-random-64-char-hex

# ── Admin portal password ──────────────────────────────────────────────────────
ROK_PORTAL_PASSWORD=change-me-use-a-strong-password

# ── JWT signing key ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ROK_JWT_SECRET=change-me-generate-a-random-64-char-hex
ROK_JWT_EXP_DAYS=30

# ── WireGuard / VPS ────────────────────────────────────────────────────────────
# Format: host:port  (e.g. 1.2.3.4:1194)
ROK_VPS_ENDPOINT=your.server.ip:1194
ROK_WG_IFACE=wg0
ROK_WG_SUBNET=10.100.0
ROK_DNS=10.100.0.1

# ── Database and peer files ────────────────────────────────────────────────────
ROK_DB_PATH=/opt/rok-vpn/db/peers.db
ROK_PEERS_DIR=/opt/rok-vpn/peers

# ── Square payments ────────────────────────────────────────────────────────────
# ROK_SQUARE_ENV: "sandbox" for testing, "production" for live payments
ROK_SQUARE_ENV=sandbox
ROK_SQUARE_TOKEN=your-square-access-token
ROK_SQUARE_LOCATION_ID=your-square-location-id

# ── Remote VPS agent ──────────────────────────────────────────────────────────
# Shared secret for portal ↔ country-VPS agent communication
ROK_AGENT_TOKEN=change-me-generate-a-random-secret
ROK_AGENT_TIMEOUT=10

# ── Portal network ─────────────────────────────────────────────────────────────
ROK_PORTAL_PORT=8080

# ── Dominio público ────────────────────────────────────────────────────────────
# Base absoluta de las etiquetas Open Graph. Los scrapers de WhatsApp e iMessage
# no resuelven rutas relativas ni siguen redirecciones http→https, así que en
# producción esto DEBE ser el dominio final con https:// y sin barra final.
# Si se deja vacío se deriva de la petición, lo cual funciona pero es frágil.
ROK_SITE_URL=https://rokvpn.com
