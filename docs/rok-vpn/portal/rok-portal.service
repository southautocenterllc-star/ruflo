[Unit]
Description=ROK VPN Portal
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rok-vpn/portal

# ── Configuración ───────────────────────────────────────────────────────────
# Todos los secretos viven en /etc/rok-vpn/portal.env (modo 0600, root),
# NO en este archivo: la unidad se versiona en git y `systemctl show` la
# expone a cualquier usuario del sistema. portal-setup.sh lo genera con
# claves aleatorias (incluye ROK_WS_PORT, ROK_SECRETS_DIR, etc.).
EnvironmentFile=/etc/rok-vpn/portal.env

# Escucha sólo en loopback: nginx es la única vía de entrada. Antes se ataba a
# 0.0.0.0 y hacía falta abrir el 8080 en nftables, lo que dejaba el portal
# accesible por HTTP plano saltándose TLS y las cabeceras de seguridad.
ExecStart=/opt/rok-vpn/portal/venv/bin/gunicorn \
  --bind 127.0.0.1:8080 \
  --workers 2 \
  --timeout 60 \
  --access-logfile - \
  --error-logfile - \
  app:app

Restart=always
RestartSec=5
User=root

# ── Endurecimiento ──────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/rok-vpn /etc/wireguard

[Install]
WantedBy=multi-user.target
